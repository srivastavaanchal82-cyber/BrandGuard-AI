# Copy to .env. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
FIREBASE_CREDENTIALS=./serviceAccount.json   # leave empty to use in-memory storage
CORS_ORIGINS=http://localhost:5173
# Image analysis reuses GEMINI_API_KEY and GEMINI_MODEL (the model must support images, e.g. gemini-2.0-flash).
